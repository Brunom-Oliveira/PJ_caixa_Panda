datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Produto {
  id            Int                   @id @default(autoincrement())
  nome          String
  valor         Float                 // Preço de Venda
  precoCusto    Float                 @default(0) // Preço de Custo
  estoque       Int
  estoqueMinimo Int                   @default(5) // Alerta de Reposição
  unidade       String                @default("UN") // UN, KG, LT, CX
  localizacao   String?               // Corredor A, Prateleira 2
  dataValidade  DateTime?             // Validade do lote atual
  criadoEm      DateTime              @default(now())
  codigos       CodigoBarras[]
  itensVenda    ItemVenda[]
  movimentacoes MovimentacaoEstoque[]
}

model CodigoBarras {
  id        Int     @id @default(autoincrement())
  codigo    String  @unique
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}


model Venda {
  id        Int         @id @default(autoincrement())
  total     Float
  dataVenda DateTime    @default(now())
  clienteId Int?
  cliente   Cliente?    @relation(fields: [clienteId], references: [id])
  itens     ItemVenda[]
}

model ItemVenda {
  id         Int     @id @default(autoincrement())
  vendaId    Int
  produtoId  Int
  quantidade Int
  subtotal   Float
  venda      Venda   @relation(fields: [vendaId], references: [id])
  produto    Produto @relation(fields: [produtoId], references: [id])
}

model Cliente {
  id       Int      @id @default(autoincrement())
  nome     String
  whatsapp String?
  email    String?
  criadoEm DateTime @default(now())
  vendas   Venda[]
}

model Configuracao {
  id          Int    @id @default(1)
  nomeMercado String @default("Panda Market")
  cnpj        String @default("00.000.000/0001-00")
  endereco    String @default("")
}

model MovimentacaoEstoque {
  id          Int      @id @default(autoincrement())
  produtoId   Int
  tipo        String   // ENTRADA, SAIDA, AJUSTE, PERDA
  quantidade  Int
  motivo      String?
  data        DateTime @default(now())
  produto     Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  senha    String
  role     String @default("OPERADOR") // OPERADOR, GERENTE, ADMIN
  criadoEm DateTime @default(now())
}

