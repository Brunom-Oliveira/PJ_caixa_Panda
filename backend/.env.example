
# URL de conexão do Supabase (PostgreSQL)
# Ex: postgresql://postgres:[SENHA]@db.[ID].supabase.co:6543/postgres
DATABASE_URL="sua_url_do_supabase_aqui"

# Chave secreta para assinar os tokens JWT (Use uma string longa e aleatória)
JWT_SECRET="sua_chave_secreta_aqui"

# Porta do servidor (Opcional, padrão 3000)
PORT=3000

# Nível de Log (info, error, debug)
LOG_LEVEL=info
